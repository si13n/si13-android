# --- Agentic Android Engineering Harness ---
# Run evidence and task contracts are regenerated per execution, never committed.
/artifacts/*
!/artifacts/.gitkeep

# Maestro's default output when a flow is run outside wrapper scripts.
/.maestro/

# Per-developer Claude Code permission/settings overrides.
# .claude/settings.json is committed because shared hooks belong to the project harness.
.claude/settings.local.json
