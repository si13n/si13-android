<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Si13" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/forgetty_primary</item>
        <item name="colorPrimaryVariant">@color/forgetty_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/forgetty_secondary</item>
        <item name="colorSecondaryVariant">@color/forgetty_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/forgetty_surface</item>
        <item name="colorOnSurface">@color/forgetty_text_primary</item>
        <item name="colorSurfaceVariant">@color/forgetty_surface_container</item>
        <item name="colorOnSurfaceVariant">@color/forgetty_text_secondary</item>
        <item name="colorOutline">@color/forgetty_outline</item>
        <item name="colorError">@color/forgetty_error</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorAccent">@color/forgetty_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/forgetty_background</item>
        <item name="android:statusBarColor">@color/forgetty_background</item>
        <item name="android:navigationBarColor">@color/forgetty_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Widget.Forgetty.IconButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">13dp</item>
    </style>

    <style name="Widget.Forgetty.Segment" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_home_segment</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/home_segment_text</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@null</item>
        <item name="iconTint">@color/home_segment_text</item>
        <item name="rippleColor">@color/forgetty_primary_container</item>
    </style>

    <style name="Widget.Forgetty.FilterChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:layout_height">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">13sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipBackgroundColor">@color/home_filter_chip_background</item>
        <item name="chipStrokeColor">@color/forgetty_outline_variant</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/home_filter_chip_text</item>
    </style>

    <style name="TextAppearance.Si13.BottomNavigation" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Si13.TaskDetails.Counter" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Si13.TaskDetails.Hint" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ShapeAppearance.Si13.BottomNavigation.ActiveIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.Si13.BottomNavigation.ActiveIndicator" parent="">
        <item name="android:color">@color/home_accent_container</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Si13.BottomNavigation.ActiveIndicator</item>
    </style>

    <style name="ThemeOverlay.Si13.HomePopup" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="colorSurface">@color/home_surface</item>
        <item name="android:colorBackground">@color/home_surface</item>
        <item name="android:textColorPrimary">@color/home_text_primary</item>
        <item name="android:textColorSecondary">@color/home_text_secondary</item>
    </style>
</resources>
