<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/list_manager_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_list_manager_sheet"
    android:orientation="vertical">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_task_details_handle"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/list_manager_back"
            style="@style/Widget.Forgetty.IconButton"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back_to_lists"
            android:visibility="gone" />

        <Space
            android:id="@+id/list_manager_header_spacer"
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/list_manager_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/manage_lists"
            android:textColor="@color/forgetty_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/list_manager_close"
            style="@style/Widget.Forgetty.IconButton"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/close_manage_lists" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/list_manager_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/list_manager_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
