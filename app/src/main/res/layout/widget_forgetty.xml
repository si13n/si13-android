<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_home_progress" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/forgetty_text_primary" android:textSize="16sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/widget_add" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="@string/new_task" android:padding="12dp" android:src="@drawable/ic_add_widget" />
    </LinearLayout>
    <TextView android:id="@+id/widget_task" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="2" android:textColor="@color/forgetty_text_secondary" android:textSize="14sp" />
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:progressTint="@color/forgetty_primary" android:progressBackgroundTint="@color/forgetty_surface_container" />
    <Button android:id="@+id/widget_complete" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:text="@string/complete" android:textAllCaps="false" android:textColor="@color/forgetty_primary" />
</LinearLayout>
