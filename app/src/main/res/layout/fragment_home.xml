<?xml version="1.0" encoding="utf-8"?>
<com.si13.app.SwipeDismissLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forgetty_background"
    tools:context=".HomeFragment">

    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/home_content_max_width">

        <LinearLayout
            android:id="@+id/home_offline_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/forgetty_surface_container"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_cloud_off"
                app:tint="@color/forgetty_text_secondary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/offline_changes_sync_later"
                android:textColor="@color/forgetty_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/home_title_column"
                android:layout_width="match_parent"
                android:layout_height="48dp">

                <TextView
                    android:id="@+id/home_date_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/forgetty_text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Saturday 1 August" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/view_mode_container"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_home_segment_container"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="3dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/list_view_button"
                        style="@style/Widget.Forgetty.Segment"
                        android:text="@string/list_view" />

                    <TextView
                        android:id="@+id/calendar_view_button"
                        style="@style/Widget.Forgetty.Segment"
                        android:text="@string/calendar_view" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/home_header_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageButton
                        android:id="@+id/task_search_button"
                        style="@style/Widget.Forgetty.HomeHeaderIcon"
                        android:contentDescription="@string/search_tasks"
                        android:src="@drawable/ic_search"
                        app:tint="@color/forgetty_text_secondary" />
                    <ImageButton
                        android:id="@+id/task_settings_button"
                        style="@style/Widget.Forgetty.HomeHeaderIcon"
                        android:contentDescription="@string/show_completed_tasks"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/forgetty_text_secondary" />
                    <ImageButton
                        android:id="@+id/task_filter_button"
                        style="@style/Widget.Forgetty.HomeHeaderIcon"
                        android:contentDescription="@string/filter_tasks"
                        android:src="@drawable/ic_filter"
                        app:tint="@color/forgetty_text_secondary" />
                    <ImageButton
                        android:id="@+id/task_sort_button"
                        style="@style/Widget.Forgetty.HomeHeaderIcon"
                        android:contentDescription="@string/sort_tasks"
                        android:src="@drawable/ic_sort"
                        app:tint="@color/forgetty_text_secondary" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/task_list_filter_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/task_list_filter_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"
                    app:selectionRequired="true"
                    app:singleLine="false"
                    app:singleSelection="true" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/task_progress_card"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/forgetty_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/forgetty_outline_variant"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/task_progress_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/forgetty_text_primary"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toTopOf="@id/task_progress_indicator"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="1 of 7 completed" />

                    <TextView
                        android:id="@+id/task_progress_encouragement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/forgetty_secondary"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@id/task_progress_text"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/task_progress_text"
                        tools:text="A good start" />

                    <ProgressBar
                        android:id="@+id/task_progress_indicator"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="10dp"
                        android:max="100"
                        android:progressDrawable="@drawable/bg_home_progress_indicator"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/task_progress_text" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/task_status_filter_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip android:id="@+id/status_filter_all" style="@style/Widget.Forgetty.FilterChip" android:layout_width="wrap_content" android:layout_height="32dp" android:checked="true" android:text="@string/all_filter" />
                    <com.google.android.material.chip.Chip android:id="@+id/status_filter_today" style="@style/Widget.Forgetty.FilterChip" android:layout_width="wrap_content" android:layout_height="32dp" android:text="@string/today_filter" />
                    <com.google.android.material.chip.Chip android:id="@+id/status_filter_high" style="@style/Widget.Forgetty.FilterChip" android:layout_width="wrap_content" android:layout_height="32dp" android:text="@string/high_priority_filter" />
                    <com.google.android.material.chip.Chip android:id="@+id/status_filter_completed" style="@style/Widget.Forgetty.FilterChip" android:layout_width="wrap_content" android:layout_height="32dp" android:text="@string/completed_filter_label" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/task_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/forgetty_overdue"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/task_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/home_calendar_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/forgetty_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/forgetty_outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageButton android:id="@+id/calendar_previous_month" style="@style/Widget.Forgetty.IconButton" android:contentDescription="@string/previous_month" android:src="@drawable/ic_chevron_left" app:tint="@color/forgetty_text_secondary" />
                            <TextView android:id="@+id/calendar_month_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:gravity="center" android:textColor="@color/forgetty_text_primary" android:textSize="15sp" tools:text="August 2026" />
                            <ImageButton android:id="@+id/calendar_next_month" style="@style/Widget.Forgetty.IconButton" android:contentDescription="@string/next_month" android:src="@drawable/ic_chevron_right" app:tint="@color/forgetty_text_secondary" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/calendar_today" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:text="@string/today" android:textAllCaps="false" android:textColor="@color/forgetty_primary" android:textSize="12sp" />
                        </LinearLayout>

                        <GridLayout
                            android:id="@+id/calendar_grid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="7"
                            android:orientation="horizontal" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:id="@+id/calendar_selected_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:fontFamily="sans-serif-medium" android:textColor="@color/forgetty_text_secondary" android:textSize="13sp" />
                <TextView android:id="@+id/calendar_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:text="@string/no_tasks_this_day" android:textColor="@color/forgetty_text_secondary" android:textSize="14sp" android:visibility="gone" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/calendar_agenda_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="16dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/empty_tasks_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@null" android:src="@drawable/ic_empty_tasks" app:tint="@color/forgetty_outline" />
                <TextView android:id="@+id/empty_tasks_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:fontFamily="sans-serif-medium" android:gravity="center" android:textColor="@color/forgetty_text_primary" android:textSize="16sp" />
                <TextView android:id="@+id/empty_tasks_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="@color/forgetty_text_secondary" android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/empty_add_task" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/add_task" android:textAllCaps="false" android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/home_loading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:visibility="gone"
                app:indicatorColor="@color/forgetty_primary" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/home_search_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/forgetty_background"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/forgetty_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <ImageButton android:id="@+id/task_search_close" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/close_search" android:padding="14dp" android:src="@drawable/ic_arrow_back" app:tint="@color/forgetty_text_primary" />
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/task_search_input" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:hint="@string/search_tasks_placeholder" android:imeOptions="actionSearch" android:inputType="text" android:singleLine="true" android:textColor="@color/forgetty_text_primary" android:textColorHint="@color/forgetty_text_secondary" android:textSize="16sp" />
            <ImageButton android:id="@+id/task_search_clear" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/clear_search" android:padding="15dp" android:src="@drawable/ic_close" android:visibility="gone" app:tint="@color/forgetty_text_secondary" />
        </LinearLayout>

        <TextView android:id="@+id/search_helper" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="40dp" android:text="@string/search_titles_notes" android:textColor="@color/forgetty_text_secondary" android:textSize="14sp" />
        <LinearLayout android:id="@+id/search_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="40dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/no_matching_tasks" android:textColor="@color/forgetty_text_primary" android:textSize="16sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/try_different_search" android:textColor="@color/forgetty_text_secondary" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/search_empty_clear" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/clear_search" android:textAllCaps="false" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/search_results" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:padding="16dp" />
    </LinearLayout>
</com.si13.app.SwipeDismissLayout>
