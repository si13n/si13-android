<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forgetty_background"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/forgetty_surface"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/add_task_close"
            style="@style/Widget.Forgetty.IconButton"
            android:contentDescription="@string/close_add_task"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/forgetty_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/add_task_title"
            android:textColor="@color/forgetty_text_primary"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/add_task_close"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/add_task_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/add_task_title_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/task_title_hint"
                app:boxBackgroundColor="@color/forgetty_surface"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:counterEnabled="true"
                app:counterMaxLength="100"
                app:endIconDrawable="@drawable/ic_mic"
                app:endIconMode="custom"
                app:endIconContentDescription="@string/voice_task">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/task_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:maxLength="100"
                    android:maxLines="3"
                    android:minHeight="72dp"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:id="@+id/task_character_counter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:clipToPadding="false" android:overScrollMode="never" android:scrollbars="none">
                <com.google.android.material.chip.ChipGroup android:id="@+id/add_task_suggestions" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipSpacingHorizontal="6dp" app:singleLine="true" />
            </HorizontalScrollView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/add_task_time_button" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/add_time" android:textAllCaps="false" app:icon="@drawable/ic_history" />
                <com.google.android.material.button.MaterialButton android:id="@+id/add_task_reminder_button" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/add_reminder" android:textAllCaps="false" app:icon="@drawable/ic_notifications" />
            </LinearLayout>

            <TextView style="@style/TextAppearance.MaterialComponents.Subtitle2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/properties" android:textColor="@color/forgetty_text_secondary" />

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:overScrollMode="never" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/add_task_priority" android:layout_width="wrap_content" android:layout_height="48dp" android:background="@drawable/bg_task_property_chip" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/priority_none" android:textColor="@color/forgetty_text_primary" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/add_task_due_button" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="@string/no_due_date" android:textAllCaps="false" app:icon="@drawable/ic_calendar" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/add_task_repeat_button" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="@string/does_not_repeat" android:textAllCaps="false" app:icon="@drawable/ic_repeat" />
                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.chip.ChipGroup android:id="@+id/add_task_due_group" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:singleSelection="true">
                <com.google.android.material.chip.Chip android:id="@+id/add_task_due_none" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
                <com.google.android.material.chip.Chip android:id="@+id/add_task_due_today" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <com.google.android.material.chip.Chip android:id="@+id/add_task_due_tomorrow" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="@string/notes" app:boxBackgroundColor="@color/forgetty_surface" app:boxCornerRadiusBottomEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusTopStart="16dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/add_task_notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top|start" android:inputType="textCapSentences|textMultiLine" android:maxLength="2000" android:minHeight="90dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/add_task_more_options" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="start|center_vertical" android:text="@string/more_options" android:textAllCaps="false" app:icon="@drawable/ic_chevron_right" />

            <LinearLayout android:id="@+id/add_task_advanced" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/TextAppearance.MaterialComponents.Subtitle2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/choose_list" android:textColor="@color/forgetty_text_secondary" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" android:scrollbars="none">
                    <com.google.android.material.chip.ChipGroup android:id="@+id/add_task_list_group" android:layout_width="wrap_content" android:layout_height="wrap_content" app:selectionRequired="true" app:singleLine="true" app:singleSelection="true" />
                </HorizontalScrollView>
                <TextView style="@style/TextAppearance.MaterialComponents.Subtitle2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/tags" android:textColor="@color/forgetty_text_secondary" />
                <com.google.android.material.chip.ChipGroup android:id="@+id/add_task_tags" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="false" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/add_subtask">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/add_task_subtask_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionDone" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:id="@+id/add_task_subtasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/add_task_attachment" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/attachment" android:textAllCaps="false" app:icon="@drawable/ic_attachment" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/add_task_location" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/location" android:textAllCaps="false" app:icon="@drawable/ic_location" />
                </LinearLayout>
                <TextView android:id="@+id/add_task_attachment_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:textColor="@color/forgetty_text_secondary" android:textSize="12sp" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/forgetty_surface" android:padding="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_task_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:enabled="false"
            android:text="@string/save_task"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:backgroundTint="@color/forgetty_primary"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />
    </LinearLayout>
</LinearLayout>
