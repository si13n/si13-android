<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/task_details_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_task_details_sheet"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:id="@+id/task_details_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:alpha="0.45"
            android:background="@drawable/bg_task_details_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/task_details_toggle_complete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mark_as_complete"
                android:padding="8dp"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/forgetty_primary" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/task_details_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:minHeight="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/task_details_more"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_options"
                android:padding="12dp"
                android:src="@drawable/ic_more_vert"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/task_details_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close_task_details"
                android:padding="13dp"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/task_details_priority"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="@string/priority"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/task_details_priority_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_flag" />

                <TextView
                    android:id="@+id/task_details_priority_value"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_task_property_chip"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/task_details_due_date"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:clickable="true"
                android:contentDescription="@string/due_date"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/task_details_due_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp">

                    <LinearLayout
                        android:id="@+id/task_details_due_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_task_property_chip"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/task_details_due_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textSize="14sp" />

                        <ImageButton
                            android:id="@+id/task_details_clear_due_date"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="-8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/clear_due_date"
                            android:padding="11dp"
                            android:src="@drawable/ic_close"
                            android:visibility="gone"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/task_details_repeat"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_repeat"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/task_details_repeat_value"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_task_property_chip"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/does_not_repeat"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="?attr/colorOutline"
            android:alpha="0.55" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/notes"
            android:textColor="@color/forgetty_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/task_details_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="2000"
            android:minHeight="92dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textSize="16sp" />

        <TextView android:id="@+id/task_details_save_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:paddingTop="4dp" android:text="@string/saved" android:textColor="@color/forgetty_text_secondary" android:textSize="12sp" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/forgetty_outline_variant" />
        <TextView style="@style/TextAppearance.MaterialComponents.Subtitle2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/subtasks" android:textColor="@color/forgetty_text_secondary" />
        <LinearLayout android:id="@+id/task_details_subtasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/forgetty_outline_variant" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/choose_list" android:textColor="@color/forgetty_text_secondary" />
            <TextView android:id="@+id/task_details_list" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:textColor="@color/forgetty_text_primary" android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/tags" android:textColor="@color/forgetty_text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/task_details_tags_edit" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="@string/edit" android:textColor="@color/forgetty_primary" android:textSize="14sp" />
        </LinearLayout>
        <com.google.android.material.chip.ChipGroup android:id="@+id/task_details_tag_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" app:chipSpacingHorizontal="8dp" app:chipSpacingVertical="6dp" app:singleLine="false" />
        <LinearLayout android:id="@+id/task_details_tag_editor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/task_details_new_tag" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:hint="@string/new_tag" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/task_details_add_tag" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginStart="8dp" android:text="@string/add" android:textAllCaps="false" />
        </LinearLayout>
        <TextView android:id="@+id/task_details_tags" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical">
            <TextView android:id="@+id/task_details_created" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/forgetty_text_secondary" android:textSize="13sp" />
            <TextView android:id="@+id/task_details_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/forgetty_text_secondary" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:id="@+id/task_details_attachments" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:textColor="@color/forgetty_text_secondary" android:textSize="13sp" android:visibility="gone" />
        <TextView android:id="@+id/task_details_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:textColor="@color/forgetty_text_secondary" android:textSize="13sp" android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/task_details_complete"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="15sp"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/task_details_delete"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="5dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/delete_task"
            android:textAllCaps="false"
            android:textColor="?attr/colorError"
            android:textSize="15sp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="16dp"
            app:strokeColor="?attr/colorError"
            app:strokeWidth="1dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/task_details_duplicate" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/duplicate" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/task_details_share" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/share" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
