<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/home_group_surface" />
            <stroke android:width="1dp" android:color="@color/home_border" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_background" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_background" />
        </shape>
    </item>
</layer-list>
